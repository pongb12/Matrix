// Matrix dotfiles - Rofi color theme (caelestia-inspired, flat, no blur)
// Deep navy surfaces + soft sky-blue accent, matching waybar and dunst.

* {
    bg: rgba(14, 17, 24, 92%);
    bg-alt: rgba(29, 36, 48, 92%);
    fg: #e6eaf2;
    fg-alt: #7d8899;
    accent: #7ab3f5;
    urgent: #ee7b93;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    width: 500px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px;
    margin: 10px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Tìm kiếm ứng dụng...";
    placeholder-color: @fg-alt;
    padding: 0 4px;
}

listview {
    lines: 8;
    padding: 0 10px;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px;
    border-radius: 8px;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
}

element urgent {
    text-color: @urgent;
}
